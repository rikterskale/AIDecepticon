PORT=8787
DATA_DIR=./runtime-data
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:4173
# Authentication modes: disabled (local development), oidc, or saml.
AUTH_MODE=disabled
AUTH_PROVIDER_LABEL=Enterprise SSO
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
TRUST_PROXY_HOPS=1
AUTH_REQUIRE_MFA=false
AUTH_DEFAULT_ROLE=auditor
AUTH_GROUPS_CLAIM=groups
AUTH_ROLE_CLAIM=aidecepticon_role
# JSON object mapping AIDecepticon roles to trusted IdP group names.
AUTH_ROLE_MAPPINGS={"platform_admin":["AIDecepticon-Admins"],"deception_engineer":["AIDecepticon-Engineers"],"analyst":["SOC-Analysts"],"auditor":["Security-Auditors"]}

# OIDC Authorization Code + PKCE configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
OIDC_REQUIRED_ACR=
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,swk

# SAML 2.0 HTTP Redirect / POST configuration. Escape certificate newlines as \n.
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=
SAML_REQUIRED_AUTHN_CONTEXT=
SAML_MFA_ATTRIBUTE=
SAML_MFA_VALUES=true,mfa

# Optional scoped API credential (at least 32 random bytes in production). With
# external identity disabled, the same key can be exchanged for a secure GUI
# session from the guided sign-in screen.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_API_PERMISSIONS=*
# Master key used to derive per-sensor command-signing keys. Required outside
# local development; use at least 32 random bytes.
SENSOR_COMMAND_SIGNING_KEY=
# Optional production infrastructure. Leave both unset to use the local JSON
# store and in-process durable command records.
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10
REDIS_URL=
REDIS_PREFIX=aidecepticon
COMMAND_SCHEDULER_INTERVAL_MS=5000
