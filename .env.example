PORT=8787
DATA_DIR=./runtime-data
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:4173
# Authentication modes: disabled (local development), oidc, or saml.
AUTH_MODE=disabled
AUTH_PROVIDER_LABEL=Enterprise SSO
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
TRUST_PROXY_HOPS=1
AUTH_REQUIRE_MFA=false
AUTH_DEFAULT_ROLE=auditor
AUTH_GROUPS_CLAIM=groups
AUTH_ROLE_CLAIM=aidecepticon_role
AUTH_ORGANIZATIONS_CLAIM=aidecepticon_organizations
AUTH_DEFAULT_ORGANIZATION_ID=org-default
# JSON object mapping AIDecepticon roles to trusted IdP group names.
AUTH_ROLE_MAPPINGS={"platform_admin":["AIDecepticon-Admins"],"deception_engineer":["AIDecepticon-Engineers"],"analyst":["SOC-Analysts"],"auditor":["Security-Auditors"]}

# OIDC Authorization Code + PKCE configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
OIDC_REQUIRED_ACR=
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,swk

# SAML 2.0 HTTP Redirect / POST configuration. Escape certificate newlines as \n.
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=
SAML_REQUIRED_AUTHN_CONTEXT=
SAML_MFA_ATTRIBUTE=
SAML_MFA_VALUES=true,mfa

# Optional scoped API credential (at least 32 random bytes in production). With
# external identity disabled, the same key can be exchanged for a secure GUI
# session from the guided sign-in screen.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_API_PERMISSIONS=*
CONTROL_PLANE_API_ORGANIZATIONS=org-default
# Master key used to derive per-sensor command-signing keys. Required outside
# local development; use at least 32 random bytes.
SENSOR_COMMAND_SIGNING_KEY=

# Secret envelopes. Local mode uses AES-256-GCM and supports key rotation by
# retaining old key IDs in the JSON keyring. Values must be base64 or 64-char
# hex encodings of exactly 32 random bytes.
SECRET_PROVIDER=local
SECRET_LOCAL_KEY_ID=primary
SECRET_LOCAL_KEYS=

# HashiCorp Vault Transit provider (SECRET_PROVIDER=vault-transit).
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=aidecepticon

# AWS KMS provider (SECRET_PROVIDER=aws-kms). Prefer workload identity.
AWS_REGION=
AWS_KMS_KEY_ID=
AWS_KMS_ENDPOINT=

# HMAC keyring for tamper-evident audit chains. Retain old key IDs when
# rotating. Each value must contain at least 32 random bytes.
AUDIT_SIGNING_KEY_ID=primary
AUDIT_SIGNING_KEYS=

# AES-256-GCM keyring for portable full-state backup archives. Values must be
# base64 or 64-character hex encodings of exactly 32 random bytes. Retain old
# key IDs while their archives remain within the recovery retention window.
BACKUP_ENCRYPTION_KEY_ID=primary
BACKUP_ENCRYPTION_KEYS=
BACKUP_DIR=./runtime-data/backups
BACKUP_RETENTION_COUNT=14
# Zero disables the built-in schedule. Manual create/validate/restore remains available.
BACKUP_SCHEDULE_INTERVAL_HOURS=0
BACKUP_MAX_ARCHIVE_BYTES=536870912
BACKUP_MAX_SNAPSHOT_BYTES=1073741824
BACKUP_MAX_SNAPSHOT_BYTES=1073741824

# Optional production infrastructure. Leave both unset to use the local JSON
# store and in-process durable command records.
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10
REDIS_URL=
REDIS_PREFIX=aidecepticon
COMMAND_SCHEDULER_INTERVAL_MS=5000
